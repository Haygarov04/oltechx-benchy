{
  "name": "oltechx-check",
  "productName": "OLTechX Check",
  "version": "0.5.1",
  "description": "Checks a PC or Mac before you sell it on OLTechX: detects the parts, stress-tests them and fills in the listing.",
  "author": "OLTechX <oltechx@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sofia-sans": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.69",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Haygarov04/oltechx-benchy.git"
  },
  "build": {
    "appId": "com.oltechx.check",
    "productName": "OLTechX Check",
    "executableName": "OLTechXCheck",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "OLTechX-Check-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "OLTechX Check",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "bg_BG"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.utilities",
      "artifactName": "OLTechX-Check-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Haygarov04",
        "repo": "oltechx-benchy",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "dmg": {
      "artifactName": "OLTechX-Check-mac-${arch}.${ext}"
    }
  }
}
